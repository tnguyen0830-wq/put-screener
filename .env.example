# From https://developer.schwab.com/dashboard/apps
SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here

# Must match the callback URL registered on your Schwab app EXACTLY
SCHWAB_CALLBACK_URL=https://127.0.0.1:3000/api/auth/callback

# Where the OAuth tokens are cached on disk (gitignored).
# On Render this must point at the mounted disk, e.g. /var/data/.tokens.json,
# or the tokens are lost on every deploy.
TOKEN_PATH=./.tokens.json

# From https://site.financialmodelingprep.com/developer/docs/dashboard
FMP_API_KEY=your_fmp_key_here

# From https://unusualwhales.com — powers three of the four sources in the
# Insider Trade tab: Congress trading, Options Flow and Dark Pool. (The fourth,
# Form 4 insider buying, comes straight from SEC and needs no key.) Leave EMPTY
# to switch those three off: they self-disable and say so, the same way Telegram
# and web push do, rather than erroring.
#
# Paid, and capped at 30,000 requests/day — a cap this app has already blown
# through once. Read "Options flow and dark pool" in CLAUDE.md before changing
# any sync cadence.
UW_API_KEY=

# Nơi lưu lịch sử mức GEX của cả hai nguồn (app tự tính từ Schwab + Unusual
# Whales). Bỏ trống thì ghi vào ./.cache/gex-history.json — hợp cho máy cá
# nhân. Trên Render phải trỏ vào đĩa bền (/var/data/...), vì đây là thứ duy
# nhất còn lại khi CẢ HAI API cùng hỏng, mà .cache thì mỗi lần deploy là mất.
# Tự cắt còn 30 ngày, ghi tối đa 15 phút một lần cho mỗi mã.
GEX_HISTORY_PATH=

# Gates /api/md/* (see src/middleware.ts). Leave EMPTY for a local server so
# the gate stays off; set it only on a publicly reachable deployment, where it
# must match the app's EXPO_PUBLIC_BACKEND_TOKEN.
MD_API_TOKEN=

# Mật khẩu vào trang (tài khoản CHỦ APP - người duy nhất thấy tab My Portfolio).
# Đây là mật khẩu của CHỦ APP và nó KHÔNG nằm trong file tài khoản dưới đây:
# chủ app không bao giờ tự khoá mình ra ngoài được, kể cả khi file kia hỏng.
APP_PASSWORD=

# Tên đăng nhập của chủ app. Bỏ trống thì là "owner". Tên này được giữ riêng,
# không tài khoản người nhà nào đặt trùng được.
APP_OWNER_USER=

# Nơi lưu tài khoản người nhà (tên + mật khẩu đã băm scrypt, mỗi người một
# salt). Bỏ trống thì là ./.cache/users.json - ổn cho máy nhà, nhưng trên
# Render thư mục build bị xoá mỗi lần deploy, nên PHẢI trỏ vào ổ đĩa gắn
# thêm: /var/data/users.json. Mật khẩu thô không bao giờ được ghi vào file.
USERS_PATH=

# HẠT GIỐNG BAN ĐẦU, không còn là nguồn sự thật. Tài khoản người nhà bây giờ
# tạo/sửa/xoá ngay trong app (menu ⚙ → Quản lý tài khoản) và lưu ở USERS_PATH
# dưới dạng đã băm. Biến này chỉ được đọc ĐÚNG MỘT LẦN, lúc file tài khoản
# còn chưa tồn tại, để chuyển tiếp từ cách cũ: "ten1:matkhau1,ten2:matkhau2".
# Sau đó sửa biến này không có tác dụng gì nữa - và đó là chủ ý: xoá một người
# trong app rồi thì biến môi trường không được phép hồi sinh họ.
# Họ dùng được Screener/Analyze/Heatmap/Insider Trade và có watchlist RIÊNG,
# nhưng KHÔNG thấy danh mục, P/L, cảnh báo hay phiên Schwab của bạn.
# Tên chỉ gồm a-z 0-9 _ - ; mật khẩu không được chứa dấu phẩy. Bỏ trống thì
# không có tài khoản phụ nào, app chạy y như trước.
APP_USERS=

# From https://console.anthropic.com/settings/keys — powers the "Claude reads
# the indicators" button in the analyze tab. Leave EMPTY to switch the feature
# off: the button then reports that the server has no key, rather than failing
# in some less legible way.
#
# This is billed API usage, separate from any Claude.ai subscription. Roughly
# 3 cents per run at Opus 5 rates.
ANTHROPIC_API_KEY=
