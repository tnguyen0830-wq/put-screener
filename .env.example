# From https://developer.schwab.com/dashboard/apps
SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here

# Must match the callback URL registered on your Schwab app EXACTLY
SCHWAB_CALLBACK_URL=https://127.0.0.1:3000/api/auth/callback

# Where the OAuth tokens are cached on disk (gitignored).
# On Render this must point at the mounted disk, e.g. /var/data/.tokens.json,
# or the tokens are lost on every deploy.
TOKEN_PATH=./.tokens.json

# From https://site.financialmodelingprep.com/developer/docs/dashboard
FMP_API_KEY=your_fmp_key_here

# From https://unusualwhales.com — powers three of the four sources in the
# Insider Trade tab: Congress trading, Options Flow and Dark Pool. (The fourth,
# Form 4 insider buying, comes straight from SEC and needs no key.) Leave EMPTY
# to switch those three off: they self-disable and say so, the same way Telegram
# and web push do, rather than erroring.
#
# Paid, and capped at 30,000 requests/day — a cap this app has already blown
# through once. Read "Options flow and dark pool" in CLAUDE.md before changing
# any sync cadence.
UW_API_KEY=

# Gates /api/md/* (see src/middleware.ts). Leave EMPTY for a local server so
# the gate stays off; set it only on a publicly reachable deployment, where it
# must match the app's EXPO_PUBLIC_BACKEND_TOKEN.
MD_API_TOKEN=

# From https://console.anthropic.com/settings/keys — powers the "Claude reads
# the indicators" button in the analyze tab. Leave EMPTY to switch the feature
# off: the button then reports that the server has no key, rather than failing
# in some less legible way.
#
# This is billed API usage, separate from any Claude.ai subscription. Roughly
# 3 cents per run at Opus 5 rates.
ANTHROPIC_API_KEY=
